---
import { skillGroups } from "../data/profile";

// Inline SVG icons keyed by name
const icons: Record<string, string> = {
  code: '<path d="M16 18l6-6-6-6M8 6l-6 6 6 6" />',
  server: '<rect x="2" y="2" width="20" height="8" rx="2" ry="2" /><rect x="2" y="14" width="20" height="8" rx="2" ry="2" /><line x1="6" y1="6" x2="6.01" y2="6" /><line x1="6" y1="18" x2="6.01" y2="18" />',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" />',
  cloud: '<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />',
  brain: '<path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2z"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />',
};
---

<section id="skills" class="py-20 sm:py-28 bg-slate-50 dark:bg-slate-900/30 border-y border-slate-200 dark:border-slate-800">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="reveal text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
        Skills
      </p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        Tech Stack & Expertise
      </h2>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-slate-600 dark:text-slate-400">
        Technologies I work with across the full stack — from backend microservices to frontend interfaces and cloud deployment.
      </p>
    </div>

    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillGroups.map((group, idx) => (
        <div
          class="reveal rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 p-6 hover:border-accent-400 dark:hover:border-accent-600 hover:shadow-lg transition-all"
          style={`transition-delay: ${idx * 60}ms`}
        >
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-100 dark:bg-accent-900/40 text-accent-600 dark:text-accent-400">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[group.icon]} />
            </div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{group.category}</h3>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="rounded-lg bg-slate-100 dark:bg-slate-800 px-3 py-1.5 text-sm font-medium text-slate-700 dark:text-slate-300">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
