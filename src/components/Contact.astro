---
import { profile } from "../data/profile";
---

<section id="contact" class="py-20 sm:py-28 bg-slate-50 dark:bg-slate-900/30 border-y border-slate-200 dark:border-slate-800">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="reveal text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
        Contact
      </p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        Let's Build Something
      </h2>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-slate-600 dark:text-slate-400">
        I'm open to fullstack engineering roles, freelance projects, and collaborations. Whether you have a project in mind or just want to connect, I'd love to hear from you.
      </p>
    </div>

    <div class="mt-10 reveal">
      <div class="grid sm:grid-cols-2 gap-4">
        <!-- GitHub -->
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 p-6 hover:border-accent-400 dark:hover:border-accent-600 hover:shadow-lg transition-all"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 group-hover:bg-accent-100 dark:group-hover:bg-accent-900/40 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12z" /></svg>
          </div>
          <div>
            <p class="font-semibold text-slate-900 dark:text-white">GitHub</p>
            <p class="text-sm text-slate-500 dark:text-slate-400">@{profile.githubUsername}</p>
          </div>
          <svg class="ml-auto h-5 w-5 text-slate-400 group-hover:text-accent-600 dark:group-hover:text-accent-400 group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>

        <!-- Email -->
        <a
          href={`mailto:${profile.email}`}
          class="group flex items-center gap-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 p-6 hover:border-accent-400 dark:hover:border-accent-600 hover:shadow-lg transition-all"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 group-hover:bg-accent-100 dark:group-hover:bg-accent-900/40 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
          </div>
          <div>
            <p class="font-semibold text-slate-900 dark:text-white">Email</p>
            <p class="text-sm text-slate-500 dark:text-slate-400">{profile.email}</p>
          </div>
          <svg class="ml-auto h-5 w-5 text-slate-400 group-hover:text-accent-600 dark:group-hover:text-accent-400 group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
      </div>

      <!-- CTA -->
      <div class="mt-8 text-center">
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-accent-600/25 hover:bg-accent-700 transition-all hover:scale-105"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
          Send a Message
        </a>
      </div>
    </div>
  </div>
</section>
